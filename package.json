{
  "name": "@chubbyts/chubbyts-http",
  "type": "module",
  "version": "3.1.0",
  "description": "Http Request/Response factories, PSR-17 inspired.",
  "keywords": [
    "chubbyts",
    "request",
    "server-request",
    "response",
    "uri",
    "middleware",
    "handler",
    "factory",
    "helper",
    "psr-7",
    "psr-15",
    "psr-17"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-http",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src tests vitest.config.ts",
    "lint": "oxlint src tests vitest.config.ts",
    "prepare": "pnpm run build",
    "test": "vitest"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-http-types": "^4.1.0",
    "qs": "^6.17.0"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-oxlint": "^1.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024"
}
